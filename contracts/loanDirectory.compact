pragma language_version 0.23;
import CompactStandardLibrary;

// Kymider — LoanDirectory (shared, Wave 2).
//
// Two jobs:
//
// 1. A public index of Loan instances, so lenders can find applications. A
//    listing is keyed by listingKey(loan address, lister's key), so it lives
//    in the lister's own slot: anyone can list any address, but only under
//    their own key, and a stranger's listing of your loan address neither
//    blocks your listing nor shares its status, records or history proof.
//    The directory cannot read the Loan instance (no cross-contract reads on
//    Midnight), so a listing proves only who listed it. Readers reconcile:
//    LoanClient.listingMatchesLoan and the console compare the listing's
//    borrower and lender with the Loan's own `borrower`/`lender` and flag a
//    listing that does not match, and the canonical listing of a loan is the
//    one under the Loan's own borrower key.
//
// 2. A private repayment record. When a loan is repaid, its lender records it
//    as a leaf in a Merkle tree. Later, a borrower applying for a new loan
//    proves they hold two repaid-loan leaves — without saying which loans,
//    which lenders, or what amounts. The new lender sees one fact: "this
//    applicant has repaid two Kymider loans".
//
// Honest limit: a leaf is only as good as the lender who recorded it. A
// borrower who lends to themselves from a second identity can mint leaves.
// Restricting the proof to a lender allowlist is the Wave 3 fix
// (docs/architecture-wave3.md, attested provenance).

// DEFAULTED is kept so CLOSED keeps its number, but nothing sets it any more:
// a default is the Loan's own status (markDefault, after due date + grace),
// and readers take it from the Loan.
export enum ListingStatus { OPEN, ACTIVE, REPAID, DEFAULTED, CLOSED }

export struct Listing {
  loan: Bytes<32>;              // the Loan instance address
  borrower: Bytes<32>;          // the lister, whose key is in the listing key
  lender: Bytes<32>;
  principal: Uint<64>;
  status: ListingStatus;
}

export ledger listings: Map<Bytes<32>, Listing>;   // listingKey(loan, borrower) -> listing
export ledger listingCount: Counter;

export ledger repaid: HistoricMerkleTree<10, Bytes<32>>;
export ledger recordedLoans: Set<Bytes<32>>;       // listing keys recorded: one record per listing
// Listing key of a new application -> number of prior repaid loans proven for it.
export ledger historyProofs: Map<Bytes<32>, Uint<8>>;

witness localSk(): Bytes<32>;

constructor() {}

export pure circuit getDappPubKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "kymider:pk:"), sk]);
}

// What a repayment record commits to. Public inputs to the tree insert; private
// inputs to the proof.
export pure circuit repaidLeaf(borrowerPk: Bytes<32>, loanAddr: Bytes<32>, lenderPk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "kymider:repaid:"), borrowerPk, loanAddr, lenderPk]);
}

// Where a borrower's listing of a loan lives. Public inputs only.
export pure circuit listingKey(loanAddr: Bytes<32>, borrowerPk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "kymider:listing:"), loanAddr, borrowerPk]);
}

// --- index ------------------------------------------------------------------

export circuit list(loanAddr: Bytes<32>, lenderPk: Bytes<32>, principal: Uint<64>): [] {
  const me = getDappPubKey(localSk());
  const key = disclose(listingKey(loanAddr, me));
  assert(!listings.member(key), "loan is already listed");
  assert(me != lenderPk, "borrower and lender must differ");
  listings.insert(key, Listing {
    loan: disclose(loanAddr),
    borrower: disclose(me),
    lender: disclose(lenderPk),
    principal: disclose(principal),
    status: ListingStatus.OPEN,
  });
  listingCount.increment(1);
}

// The parties move the listing along; the Loan instance is the source of truth
// and readers reconcile the two. Each party may make only its own moves:
//   borrower: OPEN -> CLOSED (withdraw the application)
//   lender:   OPEN -> ACTIVE, OPEN -> CLOSED
// Nobody sets REPAID here: only recordRepaid does, and only from ACTIVE.
// Nobody sets DEFAULTED: a default is the Loan's markDefault, which checks the
// due date and grace period; the directory cannot, so it does not try.
// `listing` is the listing key (listingKey(loan, borrower)).
// Honest limit: with no cross-contract reads the directory cannot see the Loan
// itself, so a lender could still mark a loan ACTIVE and record it repaid
// without disbursing. The Loan instance, which anyone can read, shows that.
export circuit updateStatus(listing: Bytes<32>, status: ListingStatus): [] {
  const me = getDappPubKey(localSk());
  assert(listings.member(disclose(listing)), "loan is not listed");
  const l = listings.lookup(disclose(listing));
  assert(me == l.borrower || me == l.lender, "only the loan's parties may update it");
  const next = disclose(status);
  assert(next != ListingStatus.REPAID, "a repayment is recorded with recordRepaid, not set");
  assert(next != ListingStatus.DEFAULTED, "a default is the Loan's own status (markDefault), not set here");
  if (disclose(me == l.borrower)) {
    assert(l.status == ListingStatus.OPEN && next == ListingStatus.CLOSED,
      "the borrower may only withdraw an open listing");
  } else {
    assert(l.status == ListingStatus.OPEN && (next == ListingStatus.ACTIVE || next == ListingStatus.CLOSED),
      "the lender may only move an OPEN listing to ACTIVE or CLOSED");
  }
  listings.insert(disclose(listing), Listing {
    loan: l.loan,
    borrower: l.borrower,
    lender: l.lender,
    principal: l.principal,
    status: next,
  });
}

// --- repayment record ---------------------------------------------------------

// `listing` is the listing key: the lender computes it from the Loan's own
// borrower key (listingKey(loan, borrower)), so it records the real
// borrower's listing, not a stranger's listing of the same address.
export circuit recordRepaid(listing: Bytes<32>): [] {
  const me = getDappPubKey(localSk());
  assert(listings.member(disclose(listing)), "loan is not listed");
  const l = listings.lookup(disclose(listing));
  assert(me == l.lender, "only the loan's lender may record a repayment");
  assert(!recordedLoans.member(disclose(listing)), "repayment already recorded");
  assert(l.status == ListingStatus.ACTIVE, "only an active listing can be recorded as repaid");
  repaid.insert(repaidLeaf(l.borrower, l.loan, l.lender));
  recordedLoans.insert(disclose(listing));
  listings.insert(disclose(listing), Listing {
    loan: l.loan,
    borrower: l.borrower,
    lender: l.lender,
    principal: l.principal,
    status: ListingStatus.REPAID,
  });
}

// Prove two prior repaid loans for the application `forLoan`. The loan
// addresses, lenders and Merkle paths are private inputs; only the count is
// written, under the caller's own listing of `forLoan`: the proof can only be
// attached to an application the caller listed, never to someone else's.
export circuit proveTwoRepaid(
  forLoan: Bytes<32>,
  loanA: Bytes<32>, lenderA: Bytes<32>, pathA: MerkleTreePath<10, Bytes<32>>,
  loanB: Bytes<32>, lenderB: Bytes<32>, pathB: MerkleTreePath<10, Bytes<32>>,
): [] {
  const me = getDappPubKey(localSk());
  const key = disclose(listingKey(forLoan, me));
  assert(listings.member(key), "application is not listed");
  assert(loanA != loanB, "the two loans must differ");
  assert(loanA != forLoan && loanB != forLoan, "a loan cannot vouch for itself");
  assert(pathA.leaf == repaidLeaf(me, loanA, lenderA), "first record is not yours");
  assert(pathB.leaf == repaidLeaf(me, loanB, lenderB), "second record is not yours");
  assert(repaid.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(pathA))), "first record is not in the directory");
  assert(repaid.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(pathB))), "second record is not in the directory");
  historyProofs.insert(key, 2);
}

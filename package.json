{
  "name": "kymider",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first loan underwriting on Midnight — Wave 1: proof-of-solvency MVP",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:contracts": "compact compile contracts/solvencyProof.compact compiled/solvency-proof && compact compile contracts/registry.compact compiled/registry",
    "compile": "npm run build:contracts",
    "compile:fast": "compact compile --skip-zk contracts/solvencyProof.compact compiled/solvency-proof && compact compile --skip-zk contracts/registry.compact compiled/registry",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:simulation": "cross-env MIDNIGHT_NETWORK=local vitest run tests/simulation",
    "test:preview": "cross-env MIDNIGHT_NETWORK=preview vitest run tests/simulation",
    "test:preprod": "cross-env MIDNIGHT_NETWORK=preprod vitest run tests/simulation",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "proof:up": "docker compose up -d --wait proof-server",
    "proof:down": "docker compose stop proof-server",
    "wait:dust": "vite-node scripts/wait-for-dust.ts",
    "demo": "vite-node client/demo.ts",
    "deploy": "vite-node client/deploy.ts",
    "check-balance": "vite-node client/check-balance.ts",
    "setup": "npm run env:up && npm run build:contracts && npm run wait:dust",
    "validate": "npm run env:up && npm run wait:dust && npm run test:simulation && npm run env:down"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0"
  },
  "packageManager": "npm@11.13.0"
}
